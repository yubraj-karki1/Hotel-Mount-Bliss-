# Local defaults are shown below. Replace every value for production.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/hotel-mount-bliss
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
# Comma-separated list of allowed frontend origins. Production origins must use HTTPS.
CLIENT_URL=http://localhost:3000
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# SMTP settings above are required in production for password resets and waitlist alerts.
# Use these only while running `npm run seed`, then remove them from the runtime environment.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_PHONE=
